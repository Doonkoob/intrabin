# ---- Intrabin configuration (copy to .env) ----

# Human-readable node name shown in the UI (defaults to the container hostname).
INTRABIN_NODE_NAME=intrabin-1

# Address the published port binds to on the host. Keep 127.0.0.1 when a reverse
# proxy (Caddy/Nginx/Traefik) terminates TLS on the same host.
INTRABIN_BIND=127.0.0.1
INTRABIN_PORT=8080

# Optional one-time setup token (>= 16 chars). If empty, a random token is printed
# in the logs on first start:  docker compose logs intrabin | grep setup_token
INTRABIN_SETUP_TOKEN=

# 32-byte master key for encrypting secrets at rest (hex or base64).
# If empty, a key file is generated in the data volume (back it up!).
# Generate one with:  openssl rand -hex 32
INTRABIN_MASTER_KEY=

# Behind a TLS-terminating reverse proxy: trust its address for X-Forwarded-For/Proto.
# INTRABIN_TRUSTED_PROXIES=172.16.0.0/12
# Force Secure cookies (auto-detected from TLS / trusted X-Forwarded-Proto otherwise).
# INTRABIN_COOKIE_SECURE=true

# Native TLS (alternative to a reverse proxy). Mount the files into the container.
# INTRABIN_TLS_CERT=/run/secrets/tls.crt
# INTRABIN_TLS_KEY=/run/secrets/tls.key

# Restrict accepted Host headers (DNS-rebinding protection), comma separated.
# INTRABIN_ALLOWED_HOSTS=intrabin.example.com

# Prometheus: scrape /metrics with "Authorization: Bearer <token>".
# INTRABIN_METRICS_TOKEN=

# Minimum allowed monitor interval (Go duration).
INTRABIN_MIN_INTERVAL=10s

INTRABIN_LOG_LEVEL=info
INTRABIN_LOG_FORMAT=json
